# k3d migration configuration — mirrors local/.env, but the backing Postgres
# is a k8s pod (beecore-net-v2 cluster), not a docker-compose container.
MIGRATIONS_PATH=./local/migrations
GOTO=1

# kubectl exec target — used by scripts/k3d/*.sh instead of `docker exec`
K3D_CONTEXT=k3d-beecore-net-v2
K3D_NAMESPACE=postgres-standalone
K3D_DEPLOYMENT=postgres-standalone

# Same identifiers as local/.env — config-k8s intentionally keeps the same
# user/db/password as the native config, only the connection host differs.
LOCAL_DB=deilora-dev
LOCAL_DB_USER=v8tix
LOCAL_DB_PASSWD=qCeGbJgz2lNIXo
# Only reachable via `kubectl port-forward svc/postgres-standalone 5432:5432`
# (see beecore-charts/k3d/doc/install.md) — used by `make migrations/k3d/*`,
# which needs a real network DSN. scripts/k3d/*.sh use kubectl exec instead
# and don't need the port-forward at all.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432

LOCAL_DB_DSN=postgres://${LOCAL_DB_USER}:${LOCAL_DB_PASSWD}@${LOCAL_DB_HOST}:${LOCAL_DB_PORT}/${LOCAL_DB}?sslmode=disable
