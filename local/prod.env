# Production migration configuration.
#
# No password here, unlike local/.env and local/k3d.env — production is a
# real credential, fetched live over SSH at the point of use instead (see
# local/scripts/prod/get_password.sh and the migrations/prod/* Makefile
# targets). Requires local/scripts/prod/connect_tunnel.sh running first
# (localhost:5433 -> SSH -> microk8s kubectl port-forward -> in-cluster
# postgres-standalone Service) — there's no direct/public route to it.
MIGRATIONS_PATH=./local/migrations
GOTO=1

# Production PostgreSQL connection (192.168.100.60, postgres-standalone namespace)
PROD_DB=deilora
PROD_DB_USER=v8tix
PROD_DB_HOST=localhost
PROD_DB_PORT=5433

# SSH details used by scripts/prod/*.sh to reach the server
PROD_SSH_KEY=~/.ssh/id_ed25519_v8tix
PROD_SSH_HOST=v8tix@192.168.100.60
